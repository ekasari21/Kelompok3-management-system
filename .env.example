# Ganti dengan output: openssl rand -hex 32
JWT_SECRET=
PORT=8080

# Salin connection string dari Neon Dashboard / Supabase.
# TLS wajib aktif (sslmode=require).
DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require'

# Opsional: database khusus test integrasi, bukan database produksi.
TEST_DATABASE_URL=

# =======================================================
# KONFIGURASI PYTHON (MODUL TEXT ANALYSIS: TF-IDF & K-MEANS)
# =======================================================
# Di Docker: Nilai ini otomatis dioverride menjadi 'python3'.
# Di Lokal Windows:
#   - Kosongkan jika Python 3 sudah ada di PATH sistem atau ada di folder .venv / venv lokal.
#   - Atau tentukan path langsung ke python.exe, contoh:
#     TEXT_ANALYSIS_PYTHON=C:\Users\User\AppData\Local\Programs\Python\Python313\python.exe
TEXT_ANALYSIS_PYTHON=

# Opsional: Custom script path jika tidak menggunakan internal/textanalysis/analyze_text.py
TEXT_ANALYSIS_SCRIPT=
